# ============================================================
# NARAYANA HEALTH — Environment Variables Template
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to version control
# ============================================================

# ── Node Environment ──────────────────────────────────────
NODE_ENV=development

# ── Strapi CMS (Server-side only) ────────────────────────
# Base URL of your Strapi instance
STRAPI_URL=http://localhost:1337
# API token from Strapi Admin → Settings → API Tokens
# Create a READ-ONLY token for content fetching
STRAPI_API_TOKEN=your-strapi-api-token-here
# Strapi webhook secret (for on-demand ISR revalidation)
STRAPI_WEBHOOK_SECRET=your-webhook-secret-here

# ── Spring Boot Transaction API (Server-side only) ────────
# Base URL of the Spring Boot microservice backend
SPRING_API_URL=http://localhost:8090
# Shared secret for Next.js BFF → Spring Boot communication
# Spring Boot validates this as X-Api-Key header
SPRING_API_KEY=your-spring-api-key-here
# JWT secret for signing patient session tokens (if handled by Next.js)
NEXT_JWT_SECRET=your-jwt-secret-minimum-32-chars-here

# ── Strapi PostgreSQL (Docker / local Strapi) ─────────────
STRAPI_DB_NAME=nh_strapi
STRAPI_DB_USER=nh_admin
STRAPI_DB_PASSWORD=nh_secret_change_in_prod
STRAPI_JWT_SECRET=change-this-in-production
STRAPI_ADMIN_JWT_SECRET=change-this-in-production
STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=change-this-in-production
STRAPI_TRANSFER_TOKEN_SALT=change-this-in-production

# ── OpenSearch (accessed via Spring Boot ONLY) ────────────
# Next.js does NOT connect to OpenSearch directly
# These are here for documentation + Docker purposes only
OPENSEARCH_URL=http://localhost:9200
# OPENSEARCH_USER=admin
# OPENSEARCH_PASSWORD=admin

# ── Redis (accessed via Spring Boot ONLY) ─────────────────
REDIS_URL=redis://localhost:6379

# ── AI / LLM (Server-side only) ──────────────────────────
# Option A: Gemini via Firebase AI Logic (recommended)
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
GOOGLE_AI_MODEL=gemini-2.0-flash
# Option B: OpenAI (fallback)
# OPENAI_API_KEY=your-openai-api-key-here

# Gemini Embedding model (for RAG)
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# ── Kafka (accessed via Spring Boot ONLY) ─────────────────
# KAFKA_BROKERS=localhost:9092

# ── Analytics & Observability ────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Sentry DSN for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# ── CDN / Media ───────────────────────────────────────────
# If Strapi uploads to S3/R2, set these on the Strapi side
# Next.js just reads the returned URLs
# NEXT_PUBLIC_MEDIA_BASE_URL=https://cdn.narayanahealth.org

# ── Site Config (public — safe for browser) ───────────────
NEXT_PUBLIC_SITE_URL=https://www.narayanahealth.org
NEXT_PUBLIC_SUPPORT_PHONE=18003090309
NEXT_PUBLIC_EMERGENCY_PHONE=18003090309

# ── Feature Flags ─────────────────────────────────────────
# Enable/disable features without redeployment
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
NEXT_PUBLIC_ENABLE_ONLINE_BOOKING=true
NEXT_PUBLIC_ENABLE_LIVE_CHAT=false
